# Local development. Copy to .env and adjust.
NODE_ENV=development
APP_ENV=dev
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/nffl_dev
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-plus-random-characters
# Where the browser loads the site (Next.js dev server)
APP_BASE_URL=http://localhost:3000
# Leave empty locally: emails (verification links, sign-in codes) are printed to the API log.
RESEND_API_KEY=
EMAIL_FROM="NFFL <no-reply@example.com>"
ADMIN_IDLE_MINUTES=30
